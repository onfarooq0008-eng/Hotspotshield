<?xml version="1.0" encoding="utf-8"?>
<!-- Dark navy panel behind the toolbar + connect button, rounded at the
     bottom only so it reads as one continuous header block, regardless of
     whether the rest of the screen is in light or dark mode. See
     values/colors.xml: "primary" is the same navy in both variants. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/primary" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
